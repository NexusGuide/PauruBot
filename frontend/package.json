{
  "name": "paurubot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test:auto-renew": "node --test tests/auto-renew.test.mjs",
    "test:broadcasts": "node --test tests/broadcasts.test.mjs",
    "test:capabilities": "node --test tests/capabilities.test.mjs",
    "test:confirm": "node --test tests/typed-confirm.test.mjs",
    "test:help": "node --test tests/help-data.test.mjs",
    "test:receipts": "node --test tests/receipts.test.mjs",
    "test:reseller-hub": "node --test tests/reseller-hub.test.mjs",
    "test:tickets": "node --test tests/ticket-desk.test.mjs",
    "test:usage": "node --test tests/usage-data.test.mjs",
    "test:ux": "node --test tests/ux.test.mjs tests/topup-intents.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "qrcode": "^1.5.4",
