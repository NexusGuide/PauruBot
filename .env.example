# --- Required -------------------------------------------------------------

# Public domain pointing at this server; Caddy obtains the TLS certificate.
DOMAIN=bot.example.com
PUBLIC_URL=https://bot.example.com

BOT_TOKEN=123456:replace-with-your-bot-token
# Telegram user IDs that are shop owners (comma separated)
OWNER_TELEGRAM_IDS=123456789

# Generate with: docker compose run --rm api gen-master-key
# Encrypts panel passwords and payment keys. Losing it makes them unreadable.
MASTER_KEY=
# Encrypts backup archives (and the MASTER_KEY copy inside them). Store it somewhere safe.
BACKUP_PASSPHRASE=

POSTGRES_PASSWORD=change-me

# --- Optional -------------------------------------------------------------

# polling or webhook (webhook needs PUBLIC_URL)
BOT_MODE=polling
# Number of reverse proxies in front of the api container (1 with the bundled Caddy)
TRUST_PROXY_HOPS=1
# Allow panels on private/loopback addresses (bot and panel on the same server)
ALLOW_PRIVATE_PANEL_HOSTS=false
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
SENTRY_DSN=
# Bearer token for /metrics (Prometheus). Leave empty to allow only private networks.
METRICS_TOKEN=
# Post ERROR logs to the "errors" Telegram log channel.
LOG_ERRORS_TO_TELEGRAM=true
