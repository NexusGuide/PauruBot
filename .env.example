# Telegram
BOT_TOKEN=123456:ABC-your-bot-token
ADMIN_IDS=123456789

# Database: SQLite for small setups, PostgreSQL for production
# DATABASE_URL=postgresql+asyncpg://paurubot:password@db:5432/paurubot
DATABASE_URL=sqlite+aiosqlite:///./data/paurubot.db

# Web panel / mini app
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Public HTTPS address of this server, e.g. https://bot.example.com
# Required for the mini app, online payment callbacks and webhook mode
PUBLIC_URL=
SECRET_KEY=change-me-to-a-long-random-string
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=

# Leave empty to use long polling; set to true to receive updates via webhook on PUBLIC_URL
USE_WEBHOOK=false

TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
